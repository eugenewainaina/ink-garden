# OS
.DS_Store

# Tooling
.gstack/
node_modules/
dist/
.vercel

# Secrets — never commit
.env
.env.*
*.local

# Private research about real people, kept at the repository root.
# The spec must never contain quotes or profiles from these sources (spec §14).
# Anchored to the root on purpose: docs/research/ holds PUBLIC research notes
# that are meant to be committed, and an unanchored `research/` swallowed them.
/evidence/
/research/
*.chat.txt
*.profile.md

# pnpm store created inside the workspace
.pnpm-store/

# Forbidden-term list for the pre-push guard. Never commit this file:
# a committed list of the names would itself be the leak.
.forbidden-terms.txt
